# Copy to .env.development.local (dev) — production values are set in the host (see render.yaml)

# ── Required ──
DATABASE_URL=postgresql://user:password@host:5432/legaforce?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string

# ── Server ──
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:5173
JWT_EXPIRES_IN=7d
DB_POOL_MAX=5

# ── Rate limiting / bot protection (https://arcjet.com) ──
ARCJET_KEY=
ARCJET_ENV=development

# ── Email: SendGrid in production, Gmail (app password) in dev / as fallback ──
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
EMAIL_USER=
EMAIL_PASSWORD=

# ── AI (CV generation, matching) ──
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── File uploads: S3 if set, otherwise local ./uploads ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
